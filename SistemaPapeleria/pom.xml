
<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.papeleria</groupId>
    <artifactId>SistemaPapeleria</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>jar</packaging>

    <name>SistemaPapeleria</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>

        <!-- CONTROLADOR JDBC DE ORACLE -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>23.26.0.0.0</version>
        </dependency>

        <!-- MODULO DE NOMINA -->
        <dependency>
            <groupId>com.papeleria</groupId>
            <artifactId>SistemaNomina</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- MODULO DE FACTURACION -->
        <dependency>
            <groupId>com.mycompany</groupId>
            <artifactId>ClienteFacturacion</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- MODULO DE SELECCION -->
        <dependency>
            <groupId>com.mycompany</groupId>
            <artifactId>Proyecto_Seleccion_Cliente</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- MODULO DE CONTABILIDAD -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>ContabilidadPapeleria</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- COMPILADOR JAVA 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- EJECUCION DEL PROYECTO -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>

        </plugins>
    </build>

</project>
